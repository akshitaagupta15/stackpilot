# Copy to .env.local (not committed).
# BACKEND_URL is used only on the server to forward /api/* calls (never shipped to the browser).
BACKEND_URL=http://127.0.0.1:8000
# Public, read-only demo key. NEXT_PUBLIC_* values are visible in the browser by design:
# never put ADMIN_TOKEN or a provider key here.
NEXT_PUBLIC_DEMO_KEY=sp_demo_local_viewer_key
